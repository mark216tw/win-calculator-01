<UserControl x:Class="Com.MiniCalculator.Views.CompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Com.MiniCalculator.Helpers"
             Loaded="OnViewLoaded">
    <UserControl.Resources>
        <Style x:Key="CompactKeyButton" TargetType="Button" BasedOn="{StaticResource KeyButton}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="1" />
        </Style>
        <Style x:Key="CompactFunctionKeyButton" TargetType="Button" BasedOn="{StaticResource FunctionKeyButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="1" />
        </Style>
        <Style x:Key="CompactAccentKeyButton" TargetType="Button" BasedOn="{StaticResource AccentKeyButton}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="1" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="6,1,6,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource DisplayBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="3,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="ExpressionBox"
                         Grid.Row="0"
                         Style="{StaticResource ExpressionBox}"
                         FontSize="13"
                         Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                         MaxLines="1"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         SelectionChanged="OnExpressionSelectionChanged" />

                <TextBlock Grid.Row="0"
                           Text="{loc:Loc Calc_ExpressionHint}"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"
                           Padding="2,1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Expression}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="1"
                           Text="{Binding ResultDisplay}"
                           ToolTip="{Binding ResultDisplay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ResultText}">
                            <Setter Property="FontSize" Value="22" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource CompactFunctionKeyButton}" Content="C" Command="{Binding ClearAllCommand}" AutomationProperties.Name="{loc:Loc Calc_A11y_ClearAll}" />
            <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource CompactFunctionKeyButton}" Content="⌫" Command="{Binding BackspaceCommand}" AutomationProperties.Name="{loc:Loc Calc_A11y_Backspace}" />
            <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource CompactKeyButton}" Content="÷" Command="{Binding InsertCommand}" CommandParameter="÷" AutomationProperties.Name="{loc:Loc Calc_A11y_Divide}" />
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource CompactKeyButton}" Content="×" Command="{Binding InsertCommand}" CommandParameter="×" AutomationProperties.Name="{loc:Loc Calc_A11y_Multiply}" />

            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource CompactKeyButton}" Content="7" Command="{Binding InsertCommand}" CommandParameter="7" />
            <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource CompactKeyButton}" Content="8" Command="{Binding InsertCommand}" CommandParameter="8" />
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource CompactKeyButton}" Content="9" Command="{Binding InsertCommand}" CommandParameter="9" />
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource CompactKeyButton}" Content="−" Command="{Binding InsertCommand}" CommandParameter="−" AutomationProperties.Name="{loc:Loc Calc_A11y_Subtract}" />

            <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource CompactKeyButton}" Content="4" Command="{Binding InsertCommand}" CommandParameter="4" />
            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource CompactKeyButton}" Content="5" Command="{Binding InsertCommand}" CommandParameter="5" />
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource CompactKeyButton}" Content="6" Command="{Binding InsertCommand}" CommandParameter="6" />
            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource CompactKeyButton}" Content="+" Command="{Binding InsertCommand}" CommandParameter="+" AutomationProperties.Name="{loc:Loc Calc_A11y_Add}" />

            <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource CompactKeyButton}" Content="1" Command="{Binding InsertCommand}" CommandParameter="1" />
            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource CompactKeyButton}" Content="2" Command="{Binding InsertCommand}" CommandParameter="2" />
            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource CompactKeyButton}" Content="3" Command="{Binding InsertCommand}" CommandParameter="3" />
            <Button Grid.Row="3" Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource CompactAccentKeyButton}" Content="=" Command="{Binding EvaluateCommand}" AutomationProperties.Name="{loc:Loc Calc_A11y_Equals}" />

            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CompactKeyButton}" Content="0" Command="{Binding InsertCommand}" CommandParameter="0" />
            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource CompactKeyButton}" Content="." Command="{Binding InsertCommand}" CommandParameter="." AutomationProperties.Name="{loc:Loc Calc_A11y_Decimal}" />
        </Grid>
    </Grid>
</UserControl>
