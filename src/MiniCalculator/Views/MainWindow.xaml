<Window x:Class="Com.MiniCalculator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Com.MiniCalculator.Helpers"
        Title="{loc:Loc App_Title}"
        Width="520" Height="780"
        MinWidth="440" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        Topmost="{Binding Settings.AlwaysOnTop, Mode=TwoWay}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding Calculator.EvaluateCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Calculator.ClearAllCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,10,12,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc App_Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="4,0,16,0" />
                <RadioButton GroupName="CalculatorMode"
                             Style="{StaticResource ModeTab}"
                             Content="{loc:Loc App_StandardMode}"
                             IsChecked="{Binding IsStandardSelected, Mode=TwoWay}"
                             Checked="OnStandardChecked" />
                <RadioButton GroupName="CalculatorMode"
                             Style="{StaticResource ModeTab}"
                             Content="{loc:Loc App_ScientificMode}"
                             IsChecked="{Binding IsScientificSelected, Mode=TwoWay}"
                             Checked="OnScientificChecked" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Content="&#xE718;"
                              IsChecked="{Binding Settings.AlwaysOnTop, Mode=TwoWay}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource PinToggle}">
                            <Setter Property="ToolTip" Value="{loc:Loc App_Pin}" />
                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc App_Pin}" />
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="ToolTip" Value="{loc:Loc App_Unpin}" />
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc App_Unpin}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE81C;"
                        Click="OnHistoryClick"
                        ToolTip="{loc:Loc App_History}"
                        AutomationProperties.Name="{loc:Loc App_History}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE713;"
                        Click="OnSettingsClick"
                        ToolTip="{loc:Loc App_Settings}"
                        AutomationProperties.Name="{loc:Loc App_Settings}" />
            </StackPanel>
        </Grid>

        <ContentControl x:Name="CalculatorHost"
                        Grid.Row="1"
                        Focusable="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
