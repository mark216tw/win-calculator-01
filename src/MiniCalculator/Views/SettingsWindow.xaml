<Window x:Class="Com.MiniCalculator.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Com.MiniCalculator.Helpers"
        xmlns:models="clr-namespace:Com.MiniCalculator.Models"
        Title="{loc:Loc Settings_Title}"
        Width="440" Height="720"
        MinWidth="380" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MiniCalculator;component/Styles/ThemeSwatches.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{loc:Loc Settings_Title}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="{loc:Loc Settings_DisplayMode}" Style="{StaticResource SectionHeader}" />
                <Border Background="{DynamicResource SurfaceAltBrush}"
                        CornerRadius="10"
                        Padding="3"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0"
                                     GroupName="DisplayModeGroup"
                                     Style="{StaticResource SegmentOption}"
                                     Content="{loc:Loc Settings_Display_System}"
                                     IsChecked="{Binding Settings.DisplayMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:DisplayMode.System}}"
                                     AutomationProperties.Name="{loc:Loc Settings_Display_System}" />
                        <RadioButton Grid.Column="1"
                                     GroupName="DisplayModeGroup"
                                     Style="{StaticResource SegmentOption}"
                                     Content="{loc:Loc Settings_Display_Light}"
                                     IsChecked="{Binding Settings.DisplayMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:DisplayMode.Light}}"
                                     AutomationProperties.Name="{loc:Loc Settings_Display_Light}" />
                        <RadioButton Grid.Column="2"
                                     GroupName="DisplayModeGroup"
                                     Style="{StaticResource SegmentOption}"
                                     Content="{loc:Loc Settings_Display_Dark}"
                                     IsChecked="{Binding Settings.DisplayMode, Mode=TwoWay, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:DisplayMode.Dark}}"
                                     AutomationProperties.Name="{loc:Loc Settings_Display_Dark}" />
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Loc Settings_Theme}" Style="{StaticResource SectionHeader}" />
                <ListBox Style="{StaticResource ThemeSwatchList}"
                         SelectedValue="{Binding Settings.Theme, Mode=TwoWay}"
                         SelectedValuePath="Tag"
                         Margin="0,0,0,16"
                         AutomationProperties.Name="{loc:Loc Settings_Theme}">
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.ClassicBlue}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_ClassicBlue}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_ClassicBlue}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_ClassicBlue}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.EyeCareYellow}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_EyeCareYellow}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_EyeCareYellow}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_EyeCareYellow}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.ForestGreen}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_ForestGreen}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_ForestGreen}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_ForestGreen}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.TwilightPurple}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_TwilightPurple}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_TwilightPurple}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_TwilightPurple}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.NeutralGray}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_NeutralGray}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_NeutralGray}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_NeutralGray}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.RosePink}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_RosePink}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_RosePink}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_RosePink}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.Teal}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_Teal}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_Teal}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_Teal}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.SunsetOrange}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_SunsetOrange}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_SunsetOrange}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_SunsetOrange}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.Indigo}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_Indigo}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_Indigo}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_Indigo}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.CoralRed}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_CoralRed}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_CoralRed}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                             <TextBlock Text="{loc:Loc Settings_Theme_CoralRed}"
                                        FontSize="12"
                                        TextAlignment="Center"
                                        Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.Lavender}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_Lavender}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_Lavender}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_Lavender}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource ThemeSwatchItem}" Tag="{x:Static models:ThemeName.WarmBrown}"
                                 AutomationProperties.Name="{loc:Loc Settings_Theme_WarmBrown}">
                        <StackPanel HorizontalAlignment="Center">
                            <Ellipse Width="26" Height="26"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Swatch_WarmBrown}"
                                     Stroke="{DynamicResource BorderBrush}"
                                     StrokeThickness="1" />
                            <TextBlock Text="{loc:Loc Settings_Theme_WarmBrown}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <CheckBox Content="{loc:Loc Settings_AlwaysOnTop}"
                          IsChecked="{Binding Settings.AlwaysOnTop, Mode=TwoWay}"
                          Margin="0,4,0,4" />

                <Border Height="1"
                        Background="{DynamicResource BorderBrush}"
                        Margin="0,16,0,12" />

                <TextBlock Text="{loc:Loc About_Title}" Style="{StaticResource SectionHeader}" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{loc:Loc About_Version}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding About.Version}"
                               HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{loc:Loc About_FileVersion}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding About.FileVersion}"
                               HorizontalAlignment="Right" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{loc:Loc About_License}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding About.License}"
                               HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="{loc:Loc About_Privacy}"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,8,0,4" />
                <TextBlock Text="{Binding About.Privacy}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource FunctionKeyButton}"
                    Content="{loc:Loc Settings_Reset}"
                    Padding="16,6"
                    MinHeight="46"
                    Click="OnResetClick" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource AccentKeyButton}"
                    Content="{loc:Loc Settings_Close}"
                    Padding="24,6"
                    MinWidth="96"
                    MinHeight="46"
                    IsCancel="True"
                    Click="OnCloseClick" />
        </DockPanel>
    </Grid>
</Window>
