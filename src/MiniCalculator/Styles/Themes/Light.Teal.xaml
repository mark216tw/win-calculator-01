<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8FAF7" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#D2F4EE" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0E2A27" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#49706B" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#BCEBE2" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F0FCFA" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#DDF7F2" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#EFFBF9" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#E1F8F3" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#CDF1EA" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#129B90" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B5F58" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
