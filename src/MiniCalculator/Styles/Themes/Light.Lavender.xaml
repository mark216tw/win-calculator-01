<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F1FF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E7E2FF" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#221A3D" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5480" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D4CCF7" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F6F3FF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#EAE3FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#F4F1FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#EBE5FF" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#DCD4FA" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7C6FD6" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9187E2" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6658C7" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
