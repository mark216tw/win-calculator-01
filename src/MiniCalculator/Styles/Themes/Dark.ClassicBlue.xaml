<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F1B2A" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#162538" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D3149" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#122031" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF4FF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5C1DB" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#294159" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#1D3149" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#24405C" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#2C4C6D" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#172739" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#1F3450" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#24405C" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FA9FF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#74BEFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2B8DE0" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08121B" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
