<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F7FA" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E7EDF3" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2733" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6B7A" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5E0EA" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F8FAFC" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#E9EFF5" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#F6F9FB" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#EBF1F6" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#DFE8F0" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#546E7A" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B8794" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#455A64" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
