<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#241019" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#311824" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#3D1F2D" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#28121C" po:Freeze="True" />
