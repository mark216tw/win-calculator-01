<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3EA" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFE2D0" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2E1A10" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6F5344" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#F8CFB8" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#FFF8F3" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#FFEADD" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#FFF7F1" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#FFEDE2" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#FFD9C2" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9480F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#F76707" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B93B08" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
