<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#211C10" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2C2615" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#362F1B" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#241F12" po:Freeze="True" />
