<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#241309" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#321B0E" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#3E2213" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#28150B" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0E6" po:Freeze="True" />
