    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#4A2917" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF8A50" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA676" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#E8733A" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#2A1206" po:Freeze="True" />
