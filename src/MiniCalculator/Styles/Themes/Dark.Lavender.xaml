<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16122A" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E1938" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#272044" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#191430" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EFEBFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BDB3E0" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#332B55" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#272044" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#2F2750" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#38305E" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#1B1633" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#241D3F" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#2F2750" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A99BFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C0B5FF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#8F7FF0" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#170F33" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
