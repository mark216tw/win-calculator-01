<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E8F4FF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#D8EBFF" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#102A43" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4F6E88" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C2DFF7" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F0F8FF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#E0F0FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#EFF7FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#E2F1FF" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#D4E9FF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F8DE0" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0067B8" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
