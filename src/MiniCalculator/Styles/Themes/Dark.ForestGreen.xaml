<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F2015" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#172C1D" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1E3725" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#122417" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF8EE" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A5C4AF" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#284330" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#1E3725" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#26452F" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#2E5139" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#182E1F" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#203C28" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#26452F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4ADE80" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6EE79A" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#34C46A" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#08210F" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
