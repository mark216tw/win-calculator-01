<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EEF0FF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#DEE2FF" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1B3A" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55587C" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C9CFFA" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F5F6FF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#E6E9FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#F2F3FF" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#E8EAFF" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#D6DBFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6366F1" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4338CA" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
