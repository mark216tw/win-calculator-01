<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#EAF8EE" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#D9F2E1" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#122A1A" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B6B55" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C2E7CE" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#F1FBF4" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#E2F6E8" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#F0FAF3" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#E4F7EA" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#D5F0DE" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F8A3B" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3AAE57" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#16702F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
