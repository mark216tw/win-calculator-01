<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFDCDC" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2B1414" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E4A4A" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#F7C6C6" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#FFF6F6" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#FFE7E7" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#FFF5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#FFEAEA" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#FFD5D5" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D64550" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E85D68" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B73540" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" po:Freeze="True" />
</ResourceDictionary>
