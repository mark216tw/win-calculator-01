<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1F1812" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2018" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#34281E" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#241B14" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAF0E4" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBB29B" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#443528" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#34281E" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#3E3025" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#49382B" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#251C15" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#2E241B" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#3E3025" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D9A066" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E8B77F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C08A4F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#22170D" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
