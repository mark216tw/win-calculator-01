<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1026" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#251735" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#2F1F43" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#1E132B" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4EBFF" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C3ADD9" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3B2853" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#2F1F43" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#3A2852" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#463260" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#271938" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#322149" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#3A2852" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#B87CFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#C99AFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A05EE8" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1B0C2C" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
