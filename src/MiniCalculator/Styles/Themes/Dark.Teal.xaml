<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D201E" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#142B28" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1A3531" po:Freeze="True" />
    <SolidColorBrush x:Key="DisplayBackgroundBrush" Color="#102421" po:Freeze="True" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6FBF7" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CC7C0" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#23423D" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyBackgroundBrush" Color="#1A3531" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyHoverBrush" Color="#21423D" po:Freeze="True" />
    <SolidColorBrush x:Key="KeyPressedBrush" Color="#294F49" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyBackgroundBrush" Color="#152C29" po:Freeze="True" />
    <SolidColorBrush x:Key="FunctionKeyHoverBrush" Color="#1C3733" po:Freeze="True" />
    <SolidColorBrush x:Key="MemoryKeyBackgroundBrush" Color="#21423D" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5FE3D2" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#22B8A5" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#062A26" po:Freeze="True" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF8A80" po:Freeze="True" />
</ResourceDictionary>
